import assert from 'node:assert/strict';
import {test} from 'node:test';
import {accountSignals} from '../src/lib/crm/account-signals';
import {accountPlanSchema,emptyAccountPlan} from '../src/lib/crm/account-plan';
const now=new Date('2026-10-27T12:00:00Z');
const input={ownerAssigned:true,lastContact:'2026-10-25T12:00:00Z',openDeals:0,decisionMakers:0,overdueActions:0,stalledDeals:0,nextFollowUp:null};
test('health is explicit, has no fabricated numeric score and requires engagement evidence',()=>{assert.equal(accountSignals(input,now).status,'Healthy');assert.equal(accountSignals({...input,lastContact:null},now).status,'Insufficient information');assert.equal(accountSignals({...input,lastContact:'2026-09-01T00:00:00Z'},now).status,'Needs attention')});
test('unavailable financial and support context creates no signals',()=>{assert.ok(accountSignals(input,now).signals.every(s=>!['collections','support'].includes(s.key)));assert.equal(accountSignals({...input,overdueInvoices:1},now).status,'At risk');assert.ok(accountSignals({...input,openTickets:2},now).signals.some(s=>s.key==='support'))});
test('buying role is explicit and only relevant when opportunities exist',()=>{assert.ok(!accountSignals(input,now).signals.some(s=>s.key==='stakeholder'));assert.ok(accountSignals({...input,openDeals:1},now).signals.some(s=>s.key==='stakeholder'));assert.ok(!accountSignals({...input,openDeals:1,decisionMakers:1},now).signals.some(s=>s.key==='stakeholder'))});
test('action and opportunity rules retain traceable explanations and destinations',()=>{const result=accountSignals({...input,overdueActions:2,stalledDeals:1,nextFollowUp:'2026-11-01T12:00:00Z'},now);assert.equal(result.status,'At risk');assert.equal(result.signals.find(s=>s.key==='actions')?.section,'plan');assert.match(result.signals.find(s=>s.key==='stalled')!.evidence,/30 days/);assert.ok(result.signals.some(s=>s.key==='upcoming'))});
test('structured plan rejects invalid progress, dates, identifiers and overlarge arrays',()=>{const item={id:crypto.randomUUID(),kind:'action',title:'Follow up',description:'',status:'planned',priority:'normal',progress:0,ownerId:null,contactId:null,dealId:null,dueDate:null,role:'',influence:''};assert.ok(accountPlanSchema.safeParse({...emptyAccountPlan,items:[item]}).success);for(const patch of [{progress:101},{dueDate:'2026-02-30'},{contactId:'not-an-id'},{status:'imaginary'},{title:''}])assert.equal(accountPlanSchema.safeParse({...emptyAccountPlan,items:[{...item,...patch}]}).success,false);assert.equal(accountPlanSchema.safeParse({...emptyAccountPlan,items:Array(101).fill(item)}).success,false)});
