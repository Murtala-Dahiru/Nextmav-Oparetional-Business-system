import { test } from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { PGlite } from '@electric-sql/pglite';
import { leadViewSchema } from '../src/lib/crm/lead-views';
import { communicationPreferencesSchema } from '../src/lib/crm/lead-preferences';
const id = (n: number) => `00000000-0000-4000-8000-${String(n).padStart(12,'0')}`;
test('saved views and preferences reject unsupported fields and invalid states', () => {
  assert.ok(leadViewSchema.safeParse({name:'Overdue',search:'',filters:{overdueFollowUp:'true'},sort:'lastName',sortDir:'asc'}).success);
  assert.equal(leadViewSchema.safeParse({name:'Unsafe',search:'',filters:{organizationId:id(2)}}).success,false);
  assert.equal(communicationPreferencesSchema.safeParse({email:'yes',phone:'unknown',doNotContact:false,note:''}).success,false);
});
test('SQL lead metrics, private saved views, stale writes, consent audit, opt-outs and conversion linkage', async () => {
  const db = new PGlite();
  try {
    await db.exec(`CREATE ROLE authenticated; CREATE ROLE anon;
      CREATE TABLE organizations(id uuid PRIMARY KEY);
      CREATE TABLE organization_members(id uuid PRIMARY KEY, organization_id uuid);
      CREATE FUNCTION auth_member_id(org uuid) RETURNS uuid LANGUAGE sql STABLE SECURITY DEFINER AS $$ SELECT id FROM organization_members WHERE organization_id=org AND id=nullif(current_setting('test.member',true),'')::uuid $$;
      CREATE FUNCTION can_access_module(org uuid,module text) RETURNS boolean LANGUAGE sql STABLE AS $$ SELECT auth_member_id(org) IS NOT NULL $$;
      CREATE FUNCTION crm_record_visible(org uuid,owner uuid) RETURNS boolean LANGUAGE sql STABLE AS $$ SELECT auth_member_id(org)=owner $$;
      CREATE TABLE leads(id uuid PRIMARY KEY,organization_id uuid,owner_id uuid,status text DEFAULT 'new',deleted_at timestamptz,converted_contact_id uuid,merged_into_id uuid);
      CREATE TABLE crm_activities(id uuid DEFAULT gen_random_uuid(),organization_id uuid,lead_id uuid,contact_id uuid,activity_type text,due_at timestamptz,completed_at timestamptz,created_at timestamptz DEFAULT now());
      INSERT INTO organizations VALUES('${id(1)}'),('${id(2)}');
      INSERT INTO organization_members VALUES('${id(10)}','${id(1)}'),('${id(11)}','${id(1)}'),('${id(20)}','${id(2)}');
      INSERT INTO leads(id,organization_id,owner_id) VALUES('${id(100)}','${id(1)}','${id(10)}'),('${id(101)}','${id(1)}','${id(10)}');
      GRANT SELECT,INSERT,UPDATE ON leads,crm_activities TO authenticated;
      ALTER TABLE leads ENABLE ROW LEVEL SECURITY;
      CREATE POLICY own_leads ON leads TO authenticated USING(crm_record_visible(organization_id,owner_id)) WITH CHECK(crm_record_visible(organization_id,owner_id));`);
    const migration = readFileSync('supabase/migrations/0068_crm_lead_acceptance.sql','utf8');
    await db.exec(migration); await db.exec(migration);
    await db.exec(`SET ROLE authenticated;SELECT set_config('test.member','${id(10)}',false)`);
    await assert.rejects(db.query('INSERT INTO leads(id,organization_id,owner_id,communication_preferences) VALUES($1,$2,$3,$4)',[id(102),id(1),id(10),JSON.stringify({email:'invalid',phone:'unknown',doNotContact:false,note:''})]),/Invalid communication preferences/);
    const metric = async () => (await db.query<any>('SELECT awaiting_response(l) AS waiting,overdue_follow_up(l) AS overdue FROM leads l WHERE id=$1',[id(100)])).rows[0];
    assert.deepEqual(await metric(),{waiting:true,overdue:false});
    await db.query('INSERT INTO crm_activities(organization_id,lead_id,activity_type,due_at) VALUES($1,$2,$3,now()-interval \'1 day\')',[id(1),id(100),'followup']);
    assert.deepEqual(await metric(),{waiting:true,overdue:true});
    await db.query('INSERT INTO crm_activities(organization_id,lead_id,activity_type) VALUES($1,$2,$3)',[id(1),id(100),'note']);
    assert.equal((await metric()).waiting,true);
    await db.query('INSERT INTO crm_activities(organization_id,lead_id,activity_type) VALUES($1,$2,$3)',[id(1),id(100),'call']);
    assert.equal((await metric()).waiting,false);
    await db.query('UPDATE leads SET status=$1 WHERE id=$2',['lost',id(100)]);
    assert.deepEqual(await metric(),{waiting:false,overdue:false});
    const views=JSON.stringify([{name:'Queue',search:'',filters:{awaitingResponse:'true'}}]);
    await db.query('SELECT crm_save_lead_views($1,0,$2)',[id(1),views]);
    assert.equal((await db.query<any>('SELECT crm_save_lead_views($1,0,$2) AS version',[id(1),views])).rows[0].version,-1);
    await db.exec(`SELECT set_config('test.member','${id(11)}',false)`);
    assert.equal((await db.query('SELECT * FROM crm_lead_views')).rows.length,0);
    await db.exec(`SELECT set_config('test.member','${id(20)}',false)`);
    await assert.rejects(db.query('SELECT crm_save_lead_views($1,0,$2)',[id(1),views]),/Not permitted/);
    await db.exec(`SELECT set_config('test.member','${id(10)}',false)`);
    const schedule=()=>db.query('INSERT INTO crm_activities(organization_id,lead_id,activity_type,due_at) VALUES($1,$2,$3,now())',[id(1),id(101),'email']);
    await assert.rejects(schedule(),/communication preferences/);
    const prefs={email:'granted',phone:'unknown',doNotContact:false,note:'Test permission'};
    await db.query('UPDATE leads SET communication_preferences=$1 WHERE id=$2',[JSON.stringify(prefs),id(101)]);
    await schedule();
    await db.query('UPDATE leads SET communication_preferences=$1,converted_contact_id=$2 WHERE id=$3',[JSON.stringify({...prefs,email:'withdrawn',doNotContact:true}),id(200),id(101)]);
    await assert.rejects(schedule(),/communication preferences/);
    await assert.rejects(db.query('INSERT INTO crm_activities(organization_id,contact_id,activity_type,due_at) VALUES($1,$2,$3,now())',[id(1),id(200),'call']),/communication preferences/);
    assert.equal((await db.query('SELECT * FROM crm_lead_preference_history')).rows.length,2);
    await assert.rejects(db.exec('DELETE FROM crm_lead_preference_history'),/permission denied/);
    await db.query('UPDATE leads SET merged_into_id=$1 WHERE id=$2',[id(100),id(101)]);
    const survivor=(await db.query<any>('SELECT communication_preferences FROM leads WHERE id=$1',[id(100)])).rows[0];
    assert.equal(survivor.communication_preferences.doNotContact,true);
    assert.equal(survivor.communication_preferences.email,'withdrawn');
  } finally { await db.close(); }
});
