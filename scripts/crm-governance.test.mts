import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import { customValuesSchema, fieldDefinitionSchema, layoutSchema } from '../src/lib/crm/customization';
import { parseCustomFilter } from '../src/lib/crm/custom-filter';
import { toCamel, toSnake } from '../src/lib/case';
const id = randomUUID();
const values = { [id]: ['Detached', 'Semi_detached'] };
assert.deepEqual(toCamel(toSnake({ customValues: values })), { customValues: values });
assert.equal(customValuesSchema.safeParse({ property_type: 'invalid key' }).success, false);
assert.equal(customValuesSchema.safeParse({ [id]: { sql: 'bad' } }).success, false);
assert.equal(customValuesSchema.safeParse({ [id]: Infinity }).success, false);
assert.deepEqual(parseCustomFilter(JSON.stringify(values)), values);
assert.throws(() => parseCustomFilter(JSON.stringify(Object.fromEntries(Array.from({ length: 11 }, () => [randomUUID(), 'a'])))));
assert.throws(() => parseCustomFilter('{"a->sql":"bad"}'));
const field = { id: null, version: 0, object: 'leads', key: 'property_type', label: 'Property type', type: 'dropdown', required: false, archived: false, options: ['Residential'], position: 0 };
assert.ok(fieldDefinitionSchema.safeParse(field).success);
for (const patch of [{ options: [] }, { options: ['A', 'A'] }, { key: 'unsafe->name' }, { object: 'users' }, { type: 'code' }, { organizationId: randomUUID() }]) assert.equal(fieldDefinitionSchema.safeParse({ ...field, ...patch }).success, false);
const section = { id: randomUUID(), title: 'Property', columns: 2, collapsed: false, fields: [id] };
assert.ok(layoutSchema.safeParse([section]).success);
assert.equal(layoutSchema.safeParse([section, { ...section, id: randomUUID() }]).success, false);
assert.equal(layoutSchema.safeParse([{ ...section, columns: 3 }]).success, false);
console.log('PASS 18 customization schema, safe filter, duplicate layout, and UUID case-conversion assertions');
