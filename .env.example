# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# ─── Database (Supabase Postgres) ──────────────────────────────────────────
#
# Supabase gives you TWO connection strings and this project needs BOTH.
# Find them in: Supabase dashboard → Project Settings → Database → Connection string
#
#   DATABASE_URL — "Transaction pooler", port 6543.
#     Used at runtime. Serverless functions open a connection per invocation,
#     so they must go through the pooler or Postgres runs out of connections.
#     Append ?pgbouncer=true&connection_limit=1
#
#   DIRECT_URL — "Direct connection", port 5432.
#     Used only by `prisma db push` / migrations, which cannot run through
#     PgBouncer in transaction mode.
#
# Replace [PASSWORD] and [PROJECT-REF] with your own values.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Supabase auth (required) ──────────────────────────────────────────────
#
# These were described here as optional, with a "demo mode" in which any
# password signed you in as the matching user from the directory. No such mode
# exists in the code — `supabaseServer()` throws when they are absent, so the
# application simply does not start. The note is removed rather than corrected
# because an authentication bypass documented as a convenience is the kind of
# thing somebody eventually goes looking for.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. Bypasses RLS entirely — server-side only, never NEXT_PUBLIC_.
#
# Three things need it and degrade honestly without it: provisioning an account
# directly, issuing a temporary password, and ending somebody's sessions when
# their access is withdrawn. Without it a suspension still refuses every
# request that account makes, but a browser it is already signed in to keeps a
# usable token until that token expires on its own.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sessions ──────────────────────────────────────────────────────────────
#
# Two clocks, both enforced server-side in `proxy.ts` from httpOnly cookies.
# IDLE resets on deliberate activity and is what protects an unattended screen.
# ABSOLUTE is a ceiling on the whole session however active it is, so a stolen
# refresh token is not good for ever. Defaults are 30 minutes and 12 hours.
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30
NEXT_PUBLIC_SESSION_ABSOLUTE_MINUTES=720
# How long before expiry the browser starts warning.
NEXT_PUBLIC_SESSION_WARNING_MINUTES=2

# ─── Rate limiting ─────────────────────────────────────────────────────────
#
# Every value below is optional. The defaults shown are what the application
# uses when nothing is set, and they are deliberately permissive — a limit set
# low on a guess gets tripped by a customer's office on a Monday morning and
# then switched off altogether, which is worse than no limit at all. Start
# here, measure, tighten with evidence.
#
# Two buckets per policy, because neither alone expresses the rule:
#
#   PER_ADDRESS  one machine hammering us. Set loosely: a hundred-person
#                office arrives through a single NAT address.
#   PER_ACCOUNT  one account attacked from many machines. This is the bucket
#                that survives a botnet and carries the real protection.
#
# Set any value to 0 to switch that bucket off. Windows are fixed in code and
# stated beside each policy.

# The rollback lever. `1` permits everything, immediately, with no deployment.
# Reach for this before reverting a release if a limit turns out to be wrong.
RATE_LIMIT_DISABLED=0

# How many proxies sit in front of this app. `x-forwarded-for` is read from the
# right by this many hops, because everything to the left of what the trusted
# proxy appended is whatever the client chose to write. One is correct for
# Vercel and for the Caddy front; raise it only if you add another hop.
RATE_LIMIT_TRUSTED_HOPS=1

# Signing in — per minute. Subject is the address being signed in as.
RATE_LIMIT_SIGN_IN_PER_ADDRESS=30
RATE_LIMIT_SIGN_IN_PER_ACCOUNT=10

# Creating an account — per hour. Subject is the address being registered.
RATE_LIMIT_SIGN_UP_PER_ADDRESS=20
RATE_LIMIT_SIGN_UP_PER_ACCOUNT=3

# Anything that makes the platform send mail to an address the caller named —
# password reset, resend confirmation. Per hour, subject is the recipient.
# Two victims: the inbox being filled, and the SMTP quota everyone shares.
RATE_LIMIT_EMAIL_PER_ADDRESS=15
RATE_LIMIT_EMAIL_PER_ACCOUNT=3

# Setting or replacing a password — per fifteen minutes. Subject is the acting
# user. /api/auth/change-password verifies the *current* password, so without
# this it is an online guessing oracle for anyone holding a stolen cookie.
RATE_LIMIT_CREDENTIAL_PER_ADDRESS=30
RATE_LIMIT_CREDENTIAL_PER_ACCOUNT=10

# Issuing and redeeming invitations — per hour. Subject is the acting user.
RATE_LIMIT_INVITATION_PER_ADDRESS=100
RATE_LIMIT_INVITATION_PER_ACCOUNT=50

# ─── Observability ─────────────────────────────────────────────────────────
#
# All optional. See OPERATIONS.md for the logging architecture and the request
# lifecycle, and docs/adr/0001-production-observability.md for why it is shaped
# this way.

# Threshold. Nothing below this is written.
# Defaults to `info` in production and `debug` everywhere else.
LOG_LEVEL=debug

# `json` for a log aggregator, `pretty` for a person reading a terminal.
# Defaults to `json` in production and `pretty` everywhere else.
LOG_FORMAT=pretty

# The environment name stamped on every log line. Defaults to NODE_ENV.
NEXT_PUBLIC_APP_ENV=development

# ─── Health endpoints ──────────────────────────────────────────────────────
#
#   GET /api          liveness — checks nothing, always cheap. Point the load
#                     balancer here. A dependency probe on this path would fail
#                     every instance at once during a database blip.
#   GET /api/health   readiness — probes the database. 200 healthy, 503 not.
#
# /api/health must be reachable without a session so a monitor can poll it,
# which is exactly why its *detail* is gated. The status code is honest for
# everybody; version, uptime, environment and dependency latency require this
# token. Leave it unset and no detail is ever served.
#
#   curl -H "Authorization: Bearer $HEALTH_TOKEN" https://…/api/health
HEALTH_TOKEN=

# How long to wait for the database before calling it unreachable.
HEALTH_PROBE_TIMEOUT_MS=3000

# How long a probe result is reused. Not an optimisation: without it the
# endpoint is an unauthenticated way to make the platform query its database as
# fast as anyone cares to ask.
HEALTH_CACHE_MS=5000

# Reported as `version` to an authorised caller. Set it at build time from the
# commit being deployed; falls back to VERCEL_GIT_COMMIT_SHA, then "unknown".
APP_VERSION=

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
