# Copy this file to `.env` and fill in the values.
# `.env` itself is gitignored and must never be committed.

# ─── Database ──────────────────────────────────────────────────────────────
# Prisma resolves relative SQLite paths from the schema directory (prisma/),
# so this steps up one level to reach db/custom.db at the project root.
DATABASE_URL="file:../db/custom.db"

# ─── Supabase (optional) ───────────────────────────────────────────────────
# Leave both blank to run in demo mode: any email/password signs in and a
# demo session cookie is issued. Set them to authenticate against Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
