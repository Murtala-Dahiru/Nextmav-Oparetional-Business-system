{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-sign-hardened/types/**/*.ts",
    ".next-sign-hardened/dev/types/**/*.ts",
    ".next-sign-delivery/types/**/*.ts",
    ".next-sign-delivery/dev/types/**/*.ts",
    ".next-sign-continuation/types/**/*.ts",
    ".next-sign-continuation/dev/types/**/*.ts",
    ".next-sign-recovery/types/**/*.ts",
    ".next-sign-recovery/dev/types/**/*.ts",
    ".next-sign-quick/types/**/*.ts",
    ".next-sign-quick/dev/types/**/*.ts",
    ".next-sign-quick-final/types/**/*.ts",
    ".next-sign-quick-final/dev/types/**/*.ts",
    ".next-sign-finishing/types/**/*.ts",
    ".next-sign-finishing/dev/types/**/*.ts",
    ".next-sign-finishing-final/types/**/*.ts",
    ".next-sign-finishing-final/dev/types/**/*.ts",
    ".next-sign-customization/types/**/*.ts",
    ".next-sign-customization/dev/types/**/*.ts",
    ".next-sign-customization-final/types/**/*.ts",
    ".next-sign-customization-final/dev/types/**/*.ts",
    ".next-sign-editor/types/**/*.ts",
    ".next-sign-editor/dev/types/**/*.ts",
    ".next-sign-editor-release/types/**/*.ts",
    ".next-sign-editor-release/dev/types/**/*.ts",
    ".next-governance-dev/types/**/*.ts",
    ".next-governance-dev/dev/types/**/*.ts",
    ".next-governance-build/types/**/*.ts",
    ".next-governance-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next*/standalone/**",
    ".next*/cache/**",
    ".next*/server/**",
    ".next-*/**"
  ]
}
