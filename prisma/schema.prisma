generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase's pooled connection (port 6543). Serverless functions open a new
  // connection per invocation, so the pooler is required — the direct
  // connection exhausts Postgres' connection limit under any real traffic.
  url      = env("DATABASE_URL")
  // Migrations and introspection cannot run through PgBouncer in transaction
  // mode, so they use the direct connection (port 5432).
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════
//  CORE: Users, Roles, Permissions, Audit
// ═══════════════════════════════════════════════════════════════════════

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   @default("changeme")
  firstName String
  lastName  String
  avatar    String   @default("")
  jobTitle  String   @default("")
  phone     String   @default("")
  department String  @default("")
  roleId    String   @default("role-user")
  isActive  Boolean  @default(true)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role              Role           @relation(fields: [roleId], references: [id])
  assignedTickets   SupportTicket[]
  ownedProjects     Project[]
  assignedTasks     ProjectTask[]
  createdLeads      Lead[]          @relation("LeadOwner")
  createdDeals      Deal[]          @relation("DealOwner")
  createdInvoices   Invoice[]       @relation("InvoiceOwner")
  createdExpenses   Expense[]       @relation("ExpenseOwner")
  sentMessages      Message[]
  createdEvents     CalendarEvent[] @relation("EventCreator")
  auditLogs         AuditLog[]
  notifications     Notification[]
  leaveRequests     LeaveRequest[]
  activities        ActivityLog[]
  stockMovements    StockMovement[] @relation("StockMovementUser")
  purchaseOrders    PurchaseOrder[] @relation("PurchaseOrderCreator")
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  description String @default("")
  isSystem    Boolean @default(false)
  permissions String // JSON string of permission map
  createdAt   DateTime @default(now())

  users User[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // "create", "update", "delete", "login", "export", "import"
  module    String   // "crm", "projects", "hr", etc.
  entity    String   // "lead", "contact", "invoice", etc.
  entityId  String   @default("")
  details   String   @default("") // JSON string of changes
  ipAddress String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("info") // "info", "warning", "success", "error"
  title     String
  message   String
  link      String   @default("") // module/entity reference
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  module    String
  action    String
  title     String
  description String @default("")
  metadata  String   @default("") // JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String @default("")
  type  String @default("string") // "string", "json", "number", "boolean"
  group String @default("general")
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════
//  CRM: Leads, Contacts, Companies, Deals, Pipeline
// ═══════════════════════════════════════════════════════════════════════

model Lead {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String   @default("")
  phone       String   @default("")
  company     String   @default("")
  title       String   @default("")
  source      String   @default("manual") // "manual", "web", "referral", "social", "email"
  status      String   @default("new") // "new", "contacted", "qualified", "proposal", "negotiation", "won", "lost"
  score       Int      @default(0)
  value       Float    @default(0)
  notes       String   @default("")
  ownerId     String   @default("u1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("LeadOwner", fields: [ownerId], references: [id])
}

model Contact {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @default("")
  phone     String   @default("")
  jobTitle  String   @default("")
  company   String   @default("")
  source    String   @default("manual")
  isActive  Boolean  @default(true)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id            String   @id @default(uuid())
  name          String
  industry      String   @default("")
  website       String   @default("")
  phone         String   @default("")
  email         String   @default("")
  city          String   @default("")
  country       String   @default("")
  employeeCount Int      @default(0)
  annualRevenue Float    @default(0)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Deal {
  id          String   @id @default(uuid())
  name        String
  value       Float    @default(0)
  stage       String   @default("prospecting") // "prospecting", "qualification", "proposal", "negotiation", "closed-won", "closed-lost"
  probability Int      @default(20)
  closeDate   DateTime @default(now())
  contactName String   @default("")
  companyName String   @default("")
  notes       String   @default("")
  ownerId     String   @default("u1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("DealOwner", fields: [ownerId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════
//  PROJECTS: Projects, Tasks
// ═══════════════════════════════════════════════════════════════════════

model Project {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  status      String   @default("planning") // "planning", "active", "on-hold", "completed", "archived"
  priority    String   @default("medium") // "low", "medium", "high", "critical"
  startDate   DateTime?
  endDate     DateTime?
  budget      Float    @default(0)
  ownerId     String   @default("u1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])
  tasks ProjectTask[]
}

model ProjectTask {
  id            String   @id @default(uuid())
  title         String
  description   String   @default("")
  status        String   @default("todo") // "todo", "in-progress", "review", "done"
  priority      String   @default("medium")
  assigneeId    String   @default("u1")
  projectId     String   @default("")
  dueDate       DateTime?
  estimatedHours Float   @default(0)
  loggedHours   Float    @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignee User @relation(fields: [assigneeId], references: [id])
  project  Project @relation(fields: [projectId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════
//  WORKSPACE: Pages
// ═══════════════════════════════════════════════════════════════════════

model WorkspacePage {
  id          String   @id @default(uuid())
  title       String
  content     String   @default("") // MDX / markdown
  icon        String   @default("file-text")
  color       String   @default("#10b981")
  parentId    String   @default("")
  isFolder    Boolean  @default(false)
  isStarred   Boolean  @default(false)
  lastEditedBy String  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════
//  COMMUNICATION: Channels, Messages
// ═══════════════════════════════════════════════════════════════════════

model Channel {
  id            String   @id @default(uuid())
  name          String
  type          String   @default("public") // "public", "private", "direct"
  description   String   @default("")
  creatorId     String   @default("u1")
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  senderId  String   @default("u1")
  channelId String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  sender  User    @relation(fields: [senderId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════════════
//  SUPPORT: Tickets
// ═══════════════════════════════════════════════════════════════════════

model SupportTicket {
  id          String   @id @default(uuid())
  ticketNumber String
  subject     String
  description String   @default("")
  priority    String   @default("medium") // "low", "medium", "high", "urgent"
  status      String   @default("open") // "open", "in-progress", "pending", "resolved", "closed"
  category    String   @default("general") // "general", "billing", "technical", "feature-request"
  contactName String   @default("")
  contactEmail String  @default("")
  assigneeId  String?
  dueDate     DateTime?
  resolution  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee User? @relation(fields: [assigneeId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════
//  HR: Employees (User alias), Leave Requests
// ═══════════════════════════════════════════════════════════════════════

model LeaveRequest {
  id          String   @id @default(uuid())
  requesterId String
  type        String   @default("vacation") // "vacation", "sick", "personal", "maternity", "paternity"
  startDate   DateTime
  endDate     DateTime
  status      String   @default("pending") // "pending", "approved", "rejected", "cancelled"
  reason      String   @default("")
  approverId  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation(fields: [requesterId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════
//  FINANCE: Invoices, Expenses
// ═══════════════════════════════════════════════════════════════════════

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  contactName   String   @default("")
  companyName   String   @default("")
  status        String   @default("draft") // "draft", "sent", "paid", "overdue", "cancelled"
  items         String   @default("[]") // JSON array of line items
  subtotal      Float    @default(0)
  tax           Float    @default(0)
  total         Float    @default(0)
  dueDate       DateTime
  paidAt        DateTime?
  notes         String   @default("")
  ownerId       String   @default("u1")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner User @relation("InvoiceOwner", fields: [ownerId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  amount      Float
  category    String   @default("general") // "general", "travel", "office", "software", "marketing"
  vendor      String   @default("")
  date        DateTime @default(now())
  status      String   @default("pending") // "pending", "approved", "rejected"
  receipt     String   @default("")
  notes       String   @default("")
  ownerId     String   @default("u1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("ExpenseOwner", fields: [ownerId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════
//  INVENTORY: Products, Warehouses
// ═══════════════════════════════════════════════════════════════════════

model Product {
  id        String  @id @default(uuid())
  name      String
  sku       String  @unique
  category  String  @default("general")
  price     Float   @default(0)
  cost      Float   @default(0)
  /// Current on-hand quantity. Never write this directly outside of a
  /// StockMovement — every change must leave an auditable trail.
  stock     Int     @default(0)
  unit      String  @default("unit")
  reorderLevel Int  @default(10)
  isActive  Boolean @default(true)
  warehouseId String?
  supplierId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  supplier  Supplier?  @relation(fields: [supplierId], references: [id])
  movements StockMovement[]
  orderItems PurchaseOrderItem[]

  @@index([warehouseId])
  @@index([supplierId])
  @@index([category])
}

model Warehouse {
  id        String  @id @default(uuid())
  name      String
  location  String  @default("")
  capacity  Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  movementsIn    StockMovement[] @relation("MovementToWarehouse")
  movementsOut   StockMovement[] @relation("MovementFromWarehouse")
  purchaseOrders PurchaseOrder[]
}

model Supplier {
  id          String  @id @default(uuid())
  name        String
  contactName String  @default("")
  email       String  @default("")
  phone       String  @default("")
  address     String  @default("")
  city        String  @default("")
  country     String  @default("")
  /// Typical lead time in days, used to flag at-risk reorders.
  leadTimeDays Int    @default(7)
  paymentTerms String @default("net30")
  notes       String  @default("")
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]
}

/// Append-only ledger of every stock change. Product.stock is the running
/// total of these rows, so on-hand quantity is always explainable.
model StockMovement {
  id          String   @id @default(uuid())
  productId   String
  /// "receipt" | "issue" | "transfer" | "adjustment" | "return"
  type        String   @default("adjustment")
  /// Signed delta applied to Product.stock: positive adds, negative removes.
  quantity    Int
  /// On-hand quantity after this movement was applied.
  balanceAfter Int     @default(0)
  reason      String   @default("")
  reference   String   @default("")
  fromWarehouseId String?
  toWarehouseId   String?
  userId      String   @default("u1")
  createdAt   DateTime @default(now())

  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse? @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])
  user          User       @relation("StockMovementUser", fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([type])
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  orderNumber String   @unique
  supplierId  String
  warehouseId String?
  /// "draft" | "submitted" | "approved" | "received" | "cancelled"
  status      String   @default("draft")
  orderDate   DateTime @default(now())
  expectedDate DateTime?
  receivedAt  DateTime?
  subtotal    Float    @default(0)
  tax         Float    @default(0)
  total       Float    @default(0)
  notes       String   @default("")
  createdById String   @default("u1")
  approvedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  warehouse  Warehouse? @relation(fields: [warehouseId], references: [id])
  createdBy  User       @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  items      PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  unitCost  Float  @default(0)
  /// Quantity actually received so far; drives partial-receipt handling.
  receivedQuantity Int @default(0)

  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ═══════════════════════════════════════════════════════════════════════
//  CALENDAR: Events
// ═══════════════════════════════════════════════════════════════════════

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  location    String   @default("")
  color       String   @default("#10b981")
  creatorId   String   @default("u1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation("EventCreator", fields: [creatorId], references: [id])
}